@startuml columnar-db-class-diagram
' Render this file with: https://www.plantuml.com/plantuml (paste text),
' IntelliJ "PlantUML integration" plugin, VS Code "PlantUML" extension,
' or draw.io (Extras -> Edit Diagram... and paste the PlantUML text).

skinparam classAttributeIconSize 0
hide empty members
left to right direction

title Колоночная БД — Лабораторные 1–2\nинтерфейсы и их реализации (репликация — только интерфейсы)

package "core" {
  interface Database {
    +createTable(name, schema): Table
    +getTable(name): Table?
    +dropTable(name): Boolean
    +listTables(): List<String>
    +flush()
    +close()
  }

  class ColumnarDatabase {
    +open(directory, cacheBytes): ColumnarDatabase
  }
  class ColumnarTable <<internal>>
  class "InMemoryColumn<T>" as InMemoryColumn
  class ColumnBlock {
    +type: DataType
    +rows: Int
    +get(index): Any?
  }

  interface Table {
    +name: String
    +schema: Schema
    +insert(row): Long
    +get(rowId): Row?
    +scan(): Sequence<Row>
    +filter(predicate): Sequence<Row>
    +sort(specs): Sequence<Row>
    +aggregate(spec): AggregateResult
  }

  interface "Column<T>" as Column {
    +name: String
    +type: DataType
    +size: Long
    +get(rowIndex): T?
    +append(value)
  }

  class Schema <<data>> {
    +columns: List<ColumnDefinition>
  }
  class ColumnDefinition <<data>> {
    +name: String
    +type: DataType
    +nullable: Boolean
  }
  class Row <<data>> {
    +values: Map<String, Any?>
  }
  enum DataType {
    INT
    LONG
    DOUBLE
    STRING
    BOOLEAN
  }
}

package "query" {
  interface Predicate {
    +test(row): Boolean
  }
  class SortSpec <<data>> {
    +columnName: String
    +ascending: Boolean
  }
  enum AggregateFunction {
    COUNT
    SUM
    AVG
    MIN
    MAX
  }
  class AggregateSpec <<data>> {
    +columnName: String
    +function: AggregateFunction
    +groupBy: String?
  }
  class AggregateResult <<data>> {
    +value: Any?
    +groups: Map<Any?, Any?>
  }
}

package "storage" {
  interface StorageEngine {
    +blockRows: Int
    +blockCount(tableName, columnName): Int
    +appendBlock(tableName, columnName, block)
    +readBlock(tableName, columnName, index): ColumnBlock
    +truncateBlocks(tableName, columnName, count)
    +readLog(tableName): TableLog?
    +appendLog(tableName, rows)
    +resetLog(tableName, firstRow, rows)
    +writeSchema(tableName, schema)
    +load(tableName): Schema?
    +listTables(): List<String>
    +deleteTable(tableName)
    +flush()
  }
  class FileStorageEngine
  class TableLog <<data>> {
    +firstRow: Long
    +rows: List<List<Any?>>
  }
}

package "cache" {
  interface CacheManager {
    +loadBlock(tableName, columnName, blockIndex): ColumnBlock
    +deleteTable(tableName)
    +isCached(tableName, columnName, blockIndex): Boolean
  }
  class LruCacheManager
}

package "compression" {
  interface ColumnCompressor {
    +compress(block): CompressedBlock
    +decompress(compressed): ColumnBlock
  }
  class DeflateColumnCompressor
  class CompressedBlock <<data>> {
    +type: DataType
    +rows: Int
    +data: ByteArray
    +originalSize: Long
  }
}

package "replication" {
  enum NodeRole {
    MASTER
    REPLICA
  }
  interface Node {
    +id: String
    +role: NodeRole
    +database: Database
  }
  interface ReplicationManager {
    +role: NodeRole
    +registerReplica(node)
    +propagate(tableName, row)
    +promoteToMaster()
  }
}

Database "1" o-- "many" Table
Table --> Schema
Table ..> Row : produces
Table ..> Predicate : filter()
Table ..> SortSpec : sort()
Table ..> AggregateSpec : aggregate()
Table ..> AggregateResult : aggregate()
Table --> Column
Schema --> ColumnDefinition
ColumnDefinition --> DataType
Column --> DataType
Table ..> StorageEngine : log + append blocks
Table ..> CacheManager : reads blocks via
StorageEngine ..> ColumnCompressor : compress/decompress
StorageEngine --> ColumnBlock
StorageEngine --> TableLog
CacheManager --> ColumnBlock
ColumnCompressor --> CompressedBlock
ColumnCompressor --> ColumnBlock
Node --> Database
Node --> NodeRole
ReplicationManager --> NodeRole
ReplicationManager ..> Node : registers/propagates

ColumnarDatabase ..|> Database
ColumnarDatabase o-- ColumnarTable
ColumnarTable ..|> Table
InMemoryColumn ..|> Column
FileStorageEngine ..|> StorageEngine
FileStorageEngine --> ColumnCompressor
LruCacheManager ..|> CacheManager
LruCacheManager --> StorageEngine
DeflateColumnCompressor ..|> ColumnCompressor

@enduml
